<?xml version="1.0" encoding="UTF-8"?>

<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="confirmLinkDialog"
        title="{i18n>confirmLinkTitle}"
        class="linkDocsSelectionDialog"
        contentWidth="900px"
        contentHeight="600px"
        draggable="true"
        resizable="true"
        stretchOnPhone="true">

        <content>

            <VBox class="confirmLinkContent sapUiMediumMargin">

                <HBox
                    alignItems="Center"
                    class="confirmDialogTitleRow">

                    <core:Icon
                        src="sap-icon://accept"
                        class="confirmDialogTitleIcon"/>

                    <Title
                        text="{i18n>confirmLinkTitle}"
                        level="H3"
                        class="confirmDialogTitle sapUiTinyMarginBegin"/>

                </HBox>

                <Text
                    text="{parts: [{model: 'i18n', path: 'linkingDescription'}, {path: 'salesDoc'}, {path: 'qt_salesDoc'}], formatter: '.formatter.formatText'}"
                    class="confirmDialogDescription sapUiSmallMarginTop"/>

                <!-- SUMMARY (values are filled by the controller) -->
                <VBox
                    id="summaryBox"
                    visible="false"
                    class="clSummaryBox">

                    <Text
                        text="{i18n>changesToBeApplied}"
                        class="clSummaryTitle"/>

                    <Text
                        id="summaryHeaderText"
                        text="&#8226; Header Fields: 0"
                        class="clSummaryLine"/>

                    <Text
                        id="summaryLineText"
                        text="&#8226; Line Item Fields: 0"
                        class="clSummaryLine"/>

                    <Text
                        id="summaryTotalText"
                        text="&#8226; Total Selected: 0"
                        class="clSummaryTotal"/>

                </VBox>

                <Text
                    text="{i18n>fieldsWillBeUpdated}"
                    class="confirmDialogIntro sapUiMediumMarginTop sapUiSmallMarginBottom"/>

                <!-- SELECT ALL (hidden by the controller when there is nothing to select) -->
                <HBox
                    id="selectAllRow"
                    alignItems="Center"
                    justifyContent="End"
                    visible="false"
                    class="clSelectAllRow">

                    <CheckBox
                        id="selectAllCheckBox"
                        text="{i18n>selectAll}"
                        selected="false"
                        select=".onSelectAllChange"
                        class="clSelectAllCheckBox"/>

                </HBox>

                <Title
                    id="headerFieldsTitle"
                    text="{i18n>headerFieldsTitle}"
                    level="H5"
                    class="confirmSectionTitle"/>

                <VBox
                    id="headerFieldsContainer"
                    class="confirmHeaderFieldsContainer"/>

                <Title
                    id="lineItemsTitle"
                    text="{i18n>lineItemFieldsTitle}"
                    level="H5"
                    class="confirmSectionTitle sapUiMediumMarginTop"/>

                <VBox
                    id="lineItemsContainer"
                    class="confirmLineItemsContainer"/>

                <Text
                    id="noChangesText"
                    text="{i18n>noFieldDifferences}"
                    visible="false"
                    class="sapUiMediumMarginTop"/>

            </VBox>

        </content>

        <beginButton>
            <Button
                id="linkDocumentsButton"
                text="{i18n>linkDocuments}"
                type="Accept"
                icon="sap-icon://chain-link"
                press=".onConfirmLinkDocuments"/>
        </beginButton>

        <endButton>
            <Button
                text="{i18n>cancel}"
                press=".onCloseConfirmDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>