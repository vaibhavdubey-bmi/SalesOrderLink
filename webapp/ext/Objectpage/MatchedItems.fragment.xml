<?xml version="1.0" encoding="UTF-8"?>
<core:FragmentDefinition xmlns:m="sap.m" xmlns:core="sap.ui.core">
    <!--
        MATCHED ITEMS - rows of ZC_QTO_SO_QT_MATCHED via navigation to_ZI_QTO_SO_QT_MATCHED.
        Layout classes are the "ol*" family (see css/style.css, block change#ol-final).
        Header and rows use the SAME grid, so every header sits exactly over its values.
        Column order: Item | Material | Description | Qty | Open Qty | Unit Price | Per Unit
        A cell with no value on its side shows no dot and no background.
    -->
    <m:VBox width="100%" class="olCard olCardM">
        <m:HBox justifyContent="SpaceBetween" alignItems="Center" class="olCardHead">
            <m:Title text="{i18n>lineItemDetails}" level="H4"/>
            <m:HBox class="olLegend">
                <m:ObjectStatus text="{i18n>Exact}" state="Success" icon="sap-icon://circle-task-2"/>
                <m:ObjectStatus text="{i18n>Possible}" state="Warning" icon="sap-icon://circle-task-2"/>
                <m:ObjectStatus text="{i18n>Not Possible}" state="None" icon="sap-icon://circle-task-2"/>
                <m:ObjectStatus text="{i18n>Check}" state="Error" icon="sap-icon://circle-task-2"/>
            </m:HBox>
        </m:HBox>

        <m:HBox class="olGroups" width="100%">
            <m:Text text="{i18n>salesOrderItems}" class="olGroup olGroupSO"/>
            <m:Text text="{i18n>matchedQuoteItems}" class="olGroup olGroupQT"/>
        </m:HBox>

        <m:HBox class="olRow olHeadRow" width="100%">
            <m:HBox class="olSide olSideSO" width="100%">
                <m:HBox class="olH olHL" width="100%"><m:Text text="{i18n>colItem}"/></m:HBox>
                <m:HBox class="olH olHL" width="100%"><m:Text text="{i18n>colMaterial}"/></m:HBox>
                <m:HBox class="olH olHL" width="100%"><m:Text text="{i18n>colDescription}"/></m:HBox>
                <m:HBox class="olH olHRD" width="100%"><m:Text text="{i18n>colQty}"/></m:HBox>
                <m:HBox class="olH olHRD olHopen" width="100%"><m:Text text="{i18n>colOpenQty}"/></m:HBox>
                <m:HBox class="olH olHRD" width="100%"><m:Text text="{i18n>colUnitPrice}"/></m:HBox>
                <m:HBox class="olH olHR" width="100%"><m:Text text="{= ${i18n>colPerUnit} === 'colPerUnit' ? 'Per Unit' : ${i18n>colPerUnit} }"/></m:HBox>
            </m:HBox>
            <m:HBox class="olSide olSideQT" width="100%">
                <m:HBox class="olH olHL" width="100%"><m:Text text="{i18n>colItem}"/></m:HBox>
                <m:HBox class="olH olHL" width="100%"><m:Text text="{i18n>colMaterial}"/></m:HBox>
                <m:HBox class="olH olHL" width="100%"><m:Text text="{i18n>colDescription}"/></m:HBox>
                <m:HBox class="olH olHR" width="100%"><m:Text text="{i18n>colQty}"/></m:HBox>
                <m:HBox class="olH olHRD" width="100%"><m:Text text="{i18n>colOpenQty}"/></m:HBox>
                <m:HBox class="olH olHRD" width="100%"><m:Text text="{i18n>colUnitPrice}"/></m:HBox>
                <m:HBox class="olH olHR" width="100%"><m:Text text="{= ${i18n>colPerUnit} === 'colPerUnit' ? 'Per Unit' : ${i18n>colPerUnit} }"/></m:HBox>
            </m:HBox>
        </m:HBox>

        <m:List items="{to_ZI_QTO_SO_QT_MATCHED}" noDataText="{i18n>noMatchedItems}" showSeparators="Inner" class="olList">
            <m:CustomListItem>
                <m:HBox class="olRow" width="100%">
                    <!-- SALES ORDER SIDE -->
                    <m:HBox class="olSide olSideSO" width="100%">
                        <m:HBox class="olC olL" width="100%" alignItems="Center"><m:Text text="{item}"/></m:HBox>
                        <m:HBox class="olC olMat" width="100%" alignItems="Center">
                        <m:customData>
                        <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getCellClass'}"/>
                        <core:CustomData key="has" writeToDom="true" value="{= ${material} === null || ${material} === undefined || ${material} === '' ? false : true }"/>
                        </m:customData>
                        <m:Text text="{material}"/>
                        <m:ObjectStatus icon="sap-icon://circle-task-2" class="olDot" state="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getLineState'}" visible="{= ${material} === null || ${material} === undefined || ${material} === '' ? false : true }"/>
                        </m:HBox>
                        <m:HBox class="olC olL olDesc" width="100%" alignItems="Center"><m:Text text="{= ${so_material_description} || ${so_material_Description} || ''}" wrapping="true" maxLines="3"/></m:HBox>
                        <m:HBox class="olC olR" width="100%" alignItems="Center">
                        <m:customData>
                        <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unitQty'}, {path: 'open_Qty'}], formatter: '.formatter.getQtyCellClass'}"/>
                        <core:CustomData key="has" writeToDom="true" value="{= ${so_unitQty} === null || ${so_unitQty} === undefined || ${so_unitQty} === '' ? false : true }"/>
                        </m:customData>
                        <m:Text text="{parts: [{path: 'so_unitQty'}, {path: 'so_unitQtyUom'}], formatter: '.formatter.formatQtyUnit'}"/>
                        <m:ObjectStatus icon="sap-icon://circle-task-2" class="olDot" state="{parts: [{path: 'so_unitQty'}, {path: 'open_Qty'}], formatter: '.formatter.getQtyState'}" visible="{= ${so_unitQty} === null || ${so_unitQty} === undefined || ${so_unitQty} === '' ? false : true }"/>
                        </m:HBox>
                        <m:HBox class="olC olGap" width="100%"/>
                        <m:HBox class="olC olR" width="100%" alignItems="Center">
                        <m:customData>
                        <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceCellClass'}"/>
                        <core:CustomData key="has" writeToDom="true" value="{= ${so_unit_Price} === null || ${so_unit_Price} === undefined || ${so_unit_Price} === '' ? false : true }"/>
                        </m:customData>
                        <m:Text text="{parts: [{path: 'so_unit_Price'}, {path: 'so_currency'}], formatter: '.formatter.formatPriceCur'}"/>
                        <m:ObjectStatus icon="sap-icon://circle-task-2" class="olDot" state="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceState'}" visible="{= ${so_unit_Price} === null || ${so_unit_Price} === undefined || ${so_unit_Price} === '' ? false : true }"/>
                        </m:HBox>
                        <m:HBox class="olC olR" width="100%" alignItems="Center"><m:Text text="{so_perUnitPrice_UoM}"/></m:HBox>
                    </m:HBox>
                    <!-- QUOTE SIDE -->
                    <m:HBox class="olSide olSideQT" width="100%">
                        <m:HBox class="olC olL" width="100%" alignItems="Center"><m:Text text="{qt_item}"/></m:HBox>
                        <m:HBox class="olC olMat" width="100%" alignItems="Center">
                        <m:customData>
                        <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getCellClass'}"/>
                        <core:CustomData key="has" writeToDom="true" value="{= ${qt_material} === null || ${qt_material} === undefined || ${qt_material} === '' ? false : true }"/>
                        </m:customData>
                        <m:Text text="{qt_material}"/>
                        <m:ObjectStatus icon="sap-icon://circle-task-2" class="olDot" state="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getLineState'}" visible="{= ${qt_material} === null || ${qt_material} === undefined || ${qt_material} === '' ? false : true }"/>
                        </m:HBox>
                        <m:HBox class="olC olL olDesc" width="100%" alignItems="Center"><m:Text text="{= ${qt_material_description} || ${qt_material_Description} || ''}" wrapping="true" maxLines="3"/></m:HBox>
                        <m:HBox class="olC olR" width="100%" alignItems="Center"><m:Text text="{parts: [{path: 'qt_unitQty'}, {path: 'qt_unitQtyUom'}], formatter: '.formatter.formatQtyUnit'}"/></m:HBox>
                        <m:HBox class="olC olR" width="100%" alignItems="Center">
                        <m:customData>
                        <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unitQty'}, {path: 'open_Qty'}], formatter: '.formatter.getQtyCellClass'}"/>
                        <core:CustomData key="has" writeToDom="true" value="{= ${open_Qty} === null || ${open_Qty} === undefined || ${open_Qty} === '' ? false : true }"/>
                        </m:customData>
                        <m:Text text="{parts: [{path: 'open_Qty'}, {path: 'qt_unitQtyUom'}], formatter: '.formatter.formatQtyUnit'}"/>
                        <m:ObjectStatus icon="sap-icon://circle-task-2" class="olDot" state="{parts: [{path: 'so_unitQty'}, {path: 'open_Qty'}], formatter: '.formatter.getQtyState'}" visible="{= ${open_Qty} === null || ${open_Qty} === undefined || ${open_Qty} === '' ? false : true }"/>
                        </m:HBox>
                        <m:HBox class="olC olR" width="100%" alignItems="Center">
                        <m:customData>
                        <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceCellClass'}"/>
                        <core:CustomData key="has" writeToDom="true" value="{= ${qt_unit_price} === null || ${qt_unit_price} === undefined || ${qt_unit_price} === '' ? false : true }"/>
                        </m:customData>
                        <m:Text text="{parts: [{path: 'qt_unit_price'}, {path: 'qt_currency'}], formatter: '.formatter.formatPriceCur'}"/>
                        <m:ObjectStatus icon="sap-icon://circle-task-2" class="olDot" state="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceState'}" visible="{= ${qt_unit_price} === null || ${qt_unit_price} === undefined || ${qt_unit_price} === '' ? false : true }"/>
                        </m:HBox>
                        <m:HBox class="olC olR" width="100%" alignItems="Center"><m:Text text="{qt_perUnitPrice_UoM}"/></m:HBox>
                    </m:HBox>
                </m:HBox>
            </m:CustomListItem>
        </m:List>
    </m:VBox>
</core:FragmentDefinition>