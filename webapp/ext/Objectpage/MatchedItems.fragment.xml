<?xml version="1.0" encoding="UTF-8"?>
<core:FragmentDefinition xmlns:m="sap.m" xmlns:core="sap.ui.core">
 <!-- MATCHED ITEMS: rows of ZC_QTO_SO_QT_MATCHED via navigation to_ZI_QTO_SO_QT_MATCHED. Material / qty / price get a dot AND a soft background on BOTH sides, same colour. -->
 <m:VBox width="100%" class="lineMatchCard">
 <m:HBox justifyContent="SpaceBetween" alignItems="Center" class="lineMatchHeader">
 <m:Title text="{i18n>lineItemDetails}" level="H4"/>
 <m:HBox class="lineMatchLegend">
 <m:ObjectStatus text="{i18n>legendExact}" state="Success" icon="sap-icon://circle-task-2"/>
 <m:ObjectStatus text="{i18n>legendPossible}" state="Warning" icon="sap-icon://circle-task-2"/>
 <m:ObjectStatus text="{i18n>legendNoMatch}" state="Error" icon="sap-icon://circle-task-2"/>
 <m:ObjectStatus text="{i18n>legendNotMaintained}" state="Information" icon="sap-icon://circle-task-2"/>
 </m:HBox>
 </m:HBox>
 <m:HBox class="lineMatchGroupRow" width="100%">
 <m:Text text="{i18n>salesOrderItems}" class="lineMatchGroup lineMatchGroupSO"/>
 <m:Text text="{i18n>matchedQuoteItems}" class="lineMatchGroup lineMatchGroupQT"/>
 </m:HBox>
 <m:HBox class="lineMatchRow lineMatchColHead" width="100%">
 <m:HBox class="lineMatchHalf lmColsSO" width="100%">
 <m:Text text="{i18n>colItem}" width="100%"/>
 <m:Text text="{i18n>colMaterial}" width="100%"/>
 <m:Text text="{i18n>colDescription}" width="100%"/>
 <m:Text text="{i18n>colQty}" width="100%" textAlign="End"/>
 <!-- <m:Text text="{i18n>colSBaseQty}" width="100%" textAlign="End"/> -->
 <m:Text text="{i18n>colUnitPrice}" width="100%" textAlign="End"/>
 </m:HBox>
 <m:HBox class="lineMatchHalf lmColsQT" width="100%">
 <!-- <m:Text text="{i18n>colQuoteItem}" width="100%"/> -->
 <!-- change#headeralign -->
 <m:Text
    text="{i18n>colQuoteItem}"
    width="100%"
    maxLines="1"
    wrapping="false"/>
 <m:Text text="{i18n>colMaterial}" width="100%"/>
 <m:Text text="{i18n>colDescription}" width="100%"/>
 <m:Text text="{i18n>colQty}" width="100%" textAlign="End"/>
 <!-- <m:Text text="{i18n>colQBaseQty}" width="100%" textAlign="End"/> -->
 <m:Text text="{i18n>colOpenQty}" width="100%" textAlign="End"/>
 <m:Text text="{i18n>colUnitPrice}" width="100%" textAlign="End"/>
 </m:HBox>
 </m:HBox>
 <m:List items="{to_ZI_QTO_SO_QT_MATCHED}" noDataText="{i18n>noMatchedItems}" showSeparators="Inner" class="lineMatchList">
 
 <m:CustomListItem>

 <m:HBox class="lineMatchRow" width="100%">
 <!-- SALES ORDER SIDE -->
 <m:HBox class="lineMatchHalf lmColsSO" width="100%">
 <m:Text text="{item}" width="100%"/>
 <m:HBox width="100%" alignItems="Center" class="lmCell">
 <m:customData>
 <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getCellClass'}"/>
 </m:customData>
 <m:Text text="{material}"/>
 <m:ObjectStatus icon="sap-icon://circle-task-2" class="lmDot" state="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getLineState'}"/>
 </m:HBox>
 <m:Text text="{= ${so_material_description} || ${so_material_Description} || ''}" wrapping="true" maxLines="3" width="100%"/>
 <m:HBox width="100%" alignItems="Center" justifyContent="End" class="lmCell">
 <m:customData>
 <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unitQty'}, {path: 'qt_unitQty'}], formatter: '.formatter.getQtyCellClass'}"/>
 </m:customData>
 <m:Text text="{parts: [{path: 'so_unitQty'}, {path: 'so_unitQtyUom'}], formatter: '.formatter.formatQtyUnit'}"/>
 <m:ObjectStatus icon="sap-icon://circle-task-2" class="lmDot" state="{parts: [{path: 'so_unitQty'}, {path: 'qt_unitQty'}], formatter: '.formatter.getQtyState'}"/>
 </m:HBox>
 <!-- S.BASE QTY (sales order base quantity) -->
 <!-- <m:Text text="{parts: [{path: 'so_convert_Qty'}, {path: 'so_baseUoM'}], formatter: '.formatter.formatQtyUnit'}" width="100%" textAlign="End" class="lmBaseQty"/> -->
 <m:HBox width="100%" alignItems="Center" justifyContent="End" class="lmCell">
 <m:customData>
 <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceCellClass'}"/>
 </m:customData>
 <m:Text text="{parts: [{path: 'so_unit_Price'}, {path: 'so_currency'}], formatter: '.formatter.formatPriceCur'}"/>
 <m:ObjectStatus icon="sap-icon://circle-task-2" class="lmDot" state="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceState'}"/>
 </m:HBox>
 </m:HBox>
 <!-- QUOTE SIDE (same colours as the sales order side) -->
 <m:HBox class="lineMatchHalf lmColsQT" width="100%">
 <m:Text text="{qt_item}" width="100%"/>
 <m:HBox width="100%" alignItems="Center" class="lmCell">
 <m:customData>
 <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getCellClass'}"/>
 </m:customData>
 <m:Text text="{qt_material}"/>
 <m:ObjectStatus icon="sap-icon://circle-task-2" class="lmDot" state="{parts: [{path: 'material'}, {path: 'qt_material'}], formatter: '.formatter.getLineState'}"/>
 </m:HBox>
 <m:Text text="{= ${qt_material_description} || ${qt_material_Description} || ''}" wrapping="true" maxLines="3" width="100%"/>
 <m:HBox width="100%" alignItems="Center" justifyContent="End" class="lmCell">
 <m:customData>
 <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unitQty'}, {path: 'qt_unitQty'}], formatter: '.formatter.getQtyCellClass'}"/>
 </m:customData>
 <m:Text text="{parts: [{path: 'qt_unitQty'}, {path: 'qt_unitQtyUom'}], formatter: '.formatter.formatQtyUnit'}"/>
 <m:ObjectStatus icon="sap-icon://circle-task-2" class="lmDot" state="{parts: [{path: 'so_unitQty'}, {path: 'qt_unitQty'}], formatter: '.formatter.getQtyState'}"/>
 </m:HBox>
 <!-- Q.BASE QTY (quotation base quantity) change#rbaseqty -->
 <!-- <m:Text text="{parts: [{path: 'qt_convert_Qty'}, {path: 'qt_baseUoM'}], formatter: '.formatter.formatQtyUnit'}" width="100%" textAlign="End" class="lmBaseQty"/> -->
<!-- <m:Text
 text="{parts: [{path: 'open_Qty'}, {path: 'qt_unitQtyUom'}],
 formatter: '.formatter.formatQtyUnit'}"
 class="lmRemQty"/> -->

<!-- change#align -->
<m:HBox
    width="100%"
    alignItems="Center"
    justifyContent="End"
    class="lmRemQty">

    <m:Text
        text="{parts: [{path: 'open_Qty'}, {path: 'qt_unitQtyUom'}],
        formatter: '.formatter.formatQtyUnit'}"/>

</m:HBox>

 <m:HBox width="100%" alignItems="Center" justifyContent="End" class="lmCell">
 <m:customData>
 <core:CustomData key="match" writeToDom="true" value="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceCellClass'}"/>
 </m:customData>
 <m:Text text="{parts: [{path: 'qt_unit_price'}, {path: 'qt_currency'}], formatter: '.formatter.formatPriceCur'}"/>
 <m:ObjectStatus icon="sap-icon://circle-task-2" class="lmDot" state="{parts: [{path: 'so_unit_Price'}, {path: 'qt_unit_price'}], formatter: '.formatter.getPriceState'}"/>
 </m:HBox>
 </m:HBox>
 </m:HBox>
 </m:CustomListItem>
 </m:List>
 </m:VBox>
</core:FragmentDefinition>
